{
  "name": "vault-muse",
  "version": "1.0.0",
  "description": "A privacy-minded AI conversation workspace for Obsidian with explicit context and guarded note editing",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test tests/pure.test.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "demo": "node tools/serve-demo.mjs",
    "package:release": "npm run check && node tools/package-release.mjs"
  },
  "keywords": [
    "obsidian",
    "ai",
    "openai",
    "anthropic",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
